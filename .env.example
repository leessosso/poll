VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.firebaseio.com

# 관리자 비밀번호는 번들에 넣지 않는다.
# 관리자 로그인은 Firebase Authentication 이메일/비밀번호 + 커스텀 클레임 admin=true 이다.
# 설정 절차는 README 의 "보안 규칙과 관리자 로그인"을 본다.

# 화면 단체 이름. 비우면 2청년회. 1청년회 인스턴스는 VITE_ORG_NAME=1청년회
VITE_ORG_NAME=2청년회
# 비상 로그인 아이디 placeholder. 비우면 admin2ch
VITE_EMERGENCY_ADMIN_ID=admin2ch
# 2청년회 셸 SSO. 1청년회처럼 SSO가 없으면 false 로 관련 안내를 숨긴다.
VITE_SHELL_SSO_ENABLED=true
