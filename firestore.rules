rules_version = '2';

// dcc-poll 최소 보안 규칙.
// 관리자: request.auth.token.admin == true (커스텀 클레임).
// 셸 커스텀 토큰 uid는 shell_<mid> 이고 클레임은 { admin: true, mid } 다.
// uid 형식은 검사하지 않는다. admin 클레임만 본다.
// 임시 대체: isAllowlistedAdmin()을 이메일/uid 비교로 바꾸고, src/lib/admin-auth.ts 도 같이 수정한다.
// 투표자: 익명 로그인. admin 클레임이 없는 인증 사용자만 투표 전이를 할 수 있다.
// 선택값과 유권자 id는 어떤 문서에도 함께 두지 않는다.
// 선택지별 집계의 공개 여부는 polls/{id}/tally/current 가 결정한다.
// 투표 중 오르는 참여 총원 castCount 는 polls/{id}/progress/current 에만 있다.
// 투표자는 이 문서를 읽지 않는다. 관리자만 읽는다. 투표 문서는 시작·마감·결과 공개처럼 가끔 바뀔 때만 갱신된다.
// 이미 끝난 투표의 polls.castCount 는 그대로 두고, 새 표는 그 필드를 올리지 않는다.
// 예전 polls.results 필드는 지우지 않아도 투표 문서 읽기가 된다. 새 쓰기로 그 맵을 바꾸지는 못한다.
// 진행 중 집계는 관리자도 읽지 못한다. 마감 뒤에만 관리자가, 공개 뒤에만 투표자가 읽는다.
//
// 현장 입장은 모임(meetingId) 단위다.
// - meeting/current: 관리자만 읽는다. 입장 코드 원문과 현재 모임 id.
// - meetingPublic/current: 현재 모임 id 만 공개한다.
// - boardState/current: 현황판 대기/결과 모드. 로그인한 사용자는 읽고 관리자만 쓴다.
// - entryCodes/{sha256(meetingId:code)}: 아무도 읽지 못한다. 입장 때 규칙이 존재를 확인한다.
// - checkins/{meetingId}_{authUid}: 관리자와 본인만 읽는다. 익명 uid 와 번호 연결은 여기에만 있다.
// - lamps/{meetingId}_{badge}: 현황판. 번호와 상태만 있고 유권자 id는 없다.
// 새 모임을 시작하면 meetingId 가 바뀌고, 예전 입장 문서는 지우지 않고 무시된다.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAllowlistedAdmin() {
      // 클레임 설정이 어려우면 이 함수를 아래로 교체한다.
      // 없는 클레임을 바로 읽으면 규칙 평가가 실패하므로 keys()로 먼저 확인한다.
      // return signedIn() && (
      //   request.auth.uid == '관리자uid' ||
      //   (request.auth.token.keys().hasAny(['email']) && request.auth.token.email == 'admin@example.com')
      // );
      return false;
    }

    function isAdmin() {
      return signedIn()
        && (
          (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true)
          || isAllowlistedAdmin()
        );
    }

    function isVoter() {
      return signedIn() && !isAdmin();
    }

    function checkinPath(meetingId, uid) {
      return /databases/$(database)/documents/checkins/$(meetingId + '_' + uid);
    }

    function lampPath(meetingId, badge) {
      return /databases/$(database)/documents/lamps/$(meetingId + '_' + string(badge));
    }

    function currentMeetingId() {
      return get(/databases/$(database)/documents/meetingPublic/current).data.meetingId;
    }

    function validMeetingId(value) {
      return value is string && value.matches('^mtg_[0-9a-fA-F-]{36}$');
    }

    function pollPath(pollId) {
      return /databases/$(database)/documents/polls/$(pollId);
    }

    function tallyPath(pollId) {
      return /databases/$(database)/documents/polls/$(pollId)/tally/current;
    }

    function guardPath(pollId) {
      return /databases/$(database)/documents/polls/$(pollId)/voteGuards/$(request.auth.uid);
    }

    function progressPath(pollId) {
      return /databases/$(database)/documents/polls/$(pollId)/progress/current;
    }

    function partPath(pollId, voterId) {
      return /databases/$(database)/documents/polls/$(pollId)/participation/$(voterId);
    }

    function changedKeyAllowed(options, changed) {
      return changed.size() == 1 && (
        (options.size() > 0 && changed.hasAny([options[0]]))
        || (options.size() > 1 && changed.hasAny([options[1]]))
        || (options.size() > 2 && changed.hasAny([options[2]]))
        || (options.size() > 3 && changed.hasAny([options[3]]))
        || (options.size() > 4 && changed.hasAny([options[4]]))
        || (options.size() > 5 && changed.hasAny([options[5]]))
        || (options.size() > 6 && changed.hasAny([options[6]]))
        || (options.size() > 7 && changed.hasAny([options[7]]))
        || (options.size() > 8 && changed.hasAny([options[8]]))
        || (options.size() > 9 && changed.hasAny([options[9]]))
        || (options.size() > 10 && changed.hasAny([options[10]]))
        || (options.size() > 11 && changed.hasAny([options[11]]))
      );
    }

    function tallySum(options, counts) {
      return (options.size() > 0 ? counts.get(options[0], 0) : 0)
        + (options.size() > 1 ? counts.get(options[1], 0) : 0)
        + (options.size() > 2 ? counts.get(options[2], 0) : 0)
        + (options.size() > 3 ? counts.get(options[3], 0) : 0)
        + (options.size() > 4 ? counts.get(options[4], 0) : 0)
        + (options.size() > 5 ? counts.get(options[5], 0) : 0)
        + (options.size() > 6 ? counts.get(options[6], 0) : 0)
        + (options.size() > 7 ? counts.get(options[7], 0) : 0)
        + (options.size() > 8 ? counts.get(options[8], 0) : 0)
        + (options.size() > 9 ? counts.get(options[9], 0) : 0)
        + (options.size() > 10 ? counts.get(options[10], 0) : 0)
        + (options.size() > 11 ? counts.get(options[11], 0) : 0);
    }

    // results 는 예전 집계 필드다. 문서를 지우지 않고 남겨 두므로 읽기를 막지 않는다.
    // 선택과 유권자를 한 문서에 넣는 choice 등은 계속 거부한다.
    function noChoiceKeys(data) {
      return !data.keys().hasAny(['choice', 'ballot', 'selection', 'vote']);
    }

    function pollFieldSet(data) {
      return data.keys().hasOnly([
        'title', 'type', 'options', 'status', 'createdAt', 'showResults',
        'eligibilityMode', 'allowAbstain', 'eventId', 'durationSeconds',
        'startedAt', 'endsAt', 'closedAt', 'quorumTarget', 'passRatio', 'castCount',
        'expectedCount', 'results', 'meetingId'
      ]);
    }

    // 없는 예전 투표는 상한을 두지 않는다. 숫자가 있을 때만 1명 이상이다.
    function expectedCountOk(data) {
      return !data.keys().hasAny(['expectedCount'])
        || data.expectedCount == null
        || (data.expectedCount is int && data.expectedCount >= 1 && data.expectedCount <= 100000);
    }

    function legacyResultsOk(data) {
      return !data.keys().hasAny(['results']) || (data.results is map && data.results.size() <= 12);
    }

    // 이미 있는 results 는 그대로 둔다. 새로 넣거나 숫자를 고치는 쓰기는 거부한다.
    function resultsFrozen() {
      return resource.data.get('results', null) == request.resource.data.get('results', null);
    }

    function optionalNumber(data, key) {
      return !data.keys().hasAny([key]) || data[key] == null || data[key] is number;
    }

    function validPoll(data) {
      return pollFieldSet(data)
        && legacyResultsOk(data)
        && noChoiceKeys(data)
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.type in ['yesno', 'choice']
        && data.options is list
        && data.options.size() >= 1
        && data.options.size() <= 12
        && data.status in ['waiting', 'active', 'closed']
        && data.createdAt is number
        && data.showResults is bool
        && data.eligibilityMode in ['open', 'roster', 'attendance']
        && data.allowAbstain is bool
        && data.castCount is number
        && data.castCount >= 0
        && expectedCountOk(data)
        && (!data.keys().hasAny(['eventId']) || data.eventId is string)
        && (!data.keys().hasAny(['meetingId']) || data.meetingId is string)
        && optionalNumber(data, 'durationSeconds')
        && optionalNumber(data, 'startedAt')
        && optionalNumber(data, 'endsAt')
        && optionalNumber(data, 'closedAt')
        && optionalNumber(data, 'quorumTarget')
        && optionalNumber(data, 'passRatio');
    }

    function validStatusMove() {
      let before = resource.data.status;
      let after = request.resource.data.status;
      return before == after
        || (before == 'waiting' && after == 'active')
        || (before == 'active' && after == 'closed');
    }

    function pollIsOpen(poll) {
      return poll.status == 'active'
        && (
          !poll.keys().hasAny(['endsAt'])
          || poll.endsAt == null
          || request.time.toMillis() < poll.endsAt
        );
    }

    function nearNow(value) {
      return value is number
        && value > request.time.toMillis() - 300000
        && value < request.time.toMillis() + 300000;
    }

    function incrementOk(poll, beforeDoc, afterDoc) {
      let before = beforeDoc.counts;
      let after = afterDoc.counts;
      let changed = after.diff(before).affectedKeys();
      return beforeDoc.keys().hasOnly(['counts'])
        && afterDoc.keys().hasOnly(['counts'])
        && before is map
        && after is map
        && before.keys().hasAll(after.keys())
        && after.keys().hasAll(before.keys())
        && changed.size() == 1
        && changedKeyAllowed(poll.options, changed)
        && tallySum(poll.options, after) == tallySum(poll.options, before) + 1;
    }

    function participantShape(data) {
      return data.keys().hasOnly(['voterId', 'voterName', 'status', 'createdAt', 'completedAt'])
        && data.voterId is string
        && data.voterName is string
        && data.voterName.size() > 0
        && data.voterName.size() <= 40
        && data.status in ['pending', 'completed']
        && optionalNumber(data, 'createdAt')
        && optionalNumber(data, 'completedAt');
    }

    // 명단 투표는 투표 시작 때 고정한 모임(poll.meetingId)의 본인 입장만 인정한다.
    // 다시 연결로 회수된(revoked) 입장은 투표하지 못한다.
    // expectedCount 가 없으면 상한이 없다. 있으면 progress 의 현재 총원 미만일 때만 한 표를 더한다.
    // 투표 문서의 castCount 는 보지 않는다. 그 필드는 예전 투표와 마감 때 굳힌 값이다.
    function underHeadcount(poll, castCount) {
      return !poll.keys().hasAny(['expectedCount'])
        || poll.expectedCount == null
        || castCount < poll.expectedCount;
    }

    function countAdvanced(before, after) {
      return before.keys().hasOnly(['castCount'])
        && after.keys().hasOnly(['castCount'])
        && before.castCount is int
        && after.castCount is int
        && after.castCount == before.castCount + 1;
    }

    function openGuardOk(guard) {
      return guard.keys().hasOnly(['createdAt']) && nearNow(guard.createdAt);
    }

    function rosterGuardOk(poll, guard, beforePart, afterPart) {
      let voterId = guard.voterId;
      let checkin = get(checkinPath(poll.get('meetingId', ''), request.auth.uid)).data;
      return guard.keys().hasOnly(['voterId'])
        && guard.voterId is string
        && checkin.authUid == request.auth.uid
        && checkin.voterId == voterId
        && checkin.revoked == false
        && beforePart.status == 'pending'
        && afterPart.status == 'completed'
        && afterPart.voterId == voterId
        && afterPart.diff(beforePart).affectedKeys().hasOnly(['status', 'completedAt'])
        && nearNow(afterPart.completedAt)
        && participantShape(afterPart);
    }

    function attendanceGuardOk(guard, hadPart, beforePart, afterPart) {
      let voterId = guard.voterId;
      let session = get(/databases/$(database)/documents/attendanceSessions/$(guard.sessionId)).data;
      return guard.keys().hasOnly(['voterId', 'sessionId'])
        && guard.voterId is string
        && guard.sessionId is string
        && session.voterId == voterId
        && session.status == 'active'
        && session.expiresAt is number
        && request.time.toMillis() < session.expiresAt
        && afterPart.status == 'completed'
        && afterPart.voterId == voterId
        && nearNow(afterPart.completedAt)
        && participantShape(afterPart)
        && (
          (!hadPart && afterPart.keys().hasOnly(['voterId', 'voterName', 'status', 'completedAt']))
          || (
            hadPart
            && beforePart.status == 'pending'
            && afterPart.diff(beforePart).affectedKeys().hasOnly(['status', 'completedAt'])
          )
        );
    }

    // progress, tally, voteGuards 규칙에서 쓴다. 참여 문서는 여기서 읽는다.
    // 한 평가의 문서 접근은 10회가 한도다. 출석 투표의 guard 쓰기가 10회다.
    // 함수 인자는 7개가 한도라 공통 검사를 이 함수 안에 둔다.
    function foreignBallotOk(pollId, progressBefore, progressAfter, tallyBefore, tallyAfter, guard) {
      let poll = get(pollPath(pollId)).data;
      let roster = poll.eligibilityMode == 'roster';
      let attendance = poll.eligibilityMode == 'attendance';
      let voterId = roster || attendance ? guard.voterId : '';
      let hadPart = roster ? true : (attendance ? exists(partPath(pollId, voterId)) : false);
      let beforePart = hadPart ? get(partPath(pollId, voterId)).data : {};
      let afterPart = roster || attendance ? getAfter(partPath(pollId, voterId)).data : {};
      return isVoter()
        && !exists(guardPath(pollId))
        && pollIsOpen(poll)
        && countAdvanced(progressBefore, progressAfter)
        && underHeadcount(poll, progressBefore.castCount)
        && incrementOk(poll, tallyBefore, tallyAfter)
        && (
          (poll.eligibilityMode == 'open' && openGuardOk(guard))
          || (poll.eligibilityMode == 'roster' && rosterGuardOk(poll, guard, beforePart, afterPart))
          || (poll.eligibilityMode == 'attendance' && attendanceGuardOk(guard, hadPart, beforePart, afterPart))
        );
    }

    function progressBallotOk(pollId) {
      return foreignBallotOk(
        pollId,
        resource.data,
        request.resource.data,
        get(tallyPath(pollId)).data,
        getAfter(tallyPath(pollId)).data,
        getAfter(guardPath(pollId)).data
      );
    }

    function tallyBallotOk(pollId) {
      return foreignBallotOk(
        pollId,
        get(progressPath(pollId)).data,
        getAfter(progressPath(pollId)).data,
        resource.data,
        request.resource.data,
        getAfter(guardPath(pollId)).data
      );
    }

    function guardBallotOk(pollId) {
      return foreignBallotOk(
        pollId,
        get(progressPath(pollId)).data,
        getAfter(progressPath(pollId)).data,
        get(tallyPath(pollId)).data,
        getAfter(tallyPath(pollId)).data,
        request.resource.data
      );
    }

    // 참여 문서를 쓰는 규칙 전용. resource 가 이 문서라 참여 문서를 다시 읽지 않는다.
    function partBallotOk(pollId) {
      let poll = get(pollPath(pollId)).data;
      let guard = getAfter(guardPath(pollId)).data;
      let hadPart = resource != null;
      let beforePart = hadPart ? resource.data : {};
      let afterPart = request.resource.data;
      let progressBefore = get(progressPath(pollId)).data;
      let progressAfter = getAfter(progressPath(pollId)).data;
      let tallyBefore = get(tallyPath(pollId)).data;
      let tallyAfter = getAfter(tallyPath(pollId)).data;
      return isVoter()
        && poll.eligibilityMode != 'open'
        && !exists(guardPath(pollId))
        && pollIsOpen(poll)
        && countAdvanced(progressBefore, progressAfter)
        && underHeadcount(poll, progressBefore.castCount)
        && incrementOk(poll, tallyBefore, tallyAfter)
        && (
          (poll.eligibilityMode == 'roster' && rosterGuardOk(poll, guard, beforePart, afterPart))
          || (poll.eligibilityMode == 'attendance' && attendanceGuardOk(guard, hadPart, beforePart, afterPart))
        );
    }

    // 비밀투표: 진행 중에는 관리자도 선택지별 집계를 읽지 못한다.
    function canReadTally(pollId) {
      let poll = get(pollPath(pollId)).data;
      return poll.status == 'closed'
        && (isAdmin() || poll.showResults == true);
    }

    match /polls/{pollId} {
      allow read: if signedIn() && noChoiceKeys(resource.data);
      allow create: if isAdmin()
        && validPoll(request.resource.data)
        && !request.resource.data.keys().hasAny(['results'])
        && request.resource.data.status == 'waiting'
        && request.resource.data.castCount == 0
        && request.resource.data.showResults == false;
      // 투표자는 투표 문서를 고치지 않는다. 표가 들어올 때마다 이 문서가 바뀌면
      // 구독 중인 모든 투표자에게 읽기가 퍼진다.
      allow update: if isAdmin() && validPoll(request.resource.data) && validStatusMove() && resultsFrozen();
      allow delete: if isAdmin();

      match /progress/{docId} {
        allow get: if docId == 'current'
          && isAdmin()
          && (resource == null || resource.data.keys().hasOnly(['castCount']));
        allow list: if false;
        allow create: if docId == 'current'
          && isAdmin()
          && request.resource.data.keys().hasOnly(['castCount'])
          && request.resource.data.castCount is int
          && request.resource.data.castCount >= 0;
        allow update: if docId == 'current' && (
          isAdmin()
            && request.resource.data.keys().hasOnly(['castCount'])
            && request.resource.data.castCount is int
            && request.resource.data.castCount >= resource.data.castCount
          || progressBallotOk(pollId)
        );
        allow delete: if false;
      }

      match /tally/{docId} {
        allow read: if docId == 'current'
          && resource.data.keys().hasOnly(['counts'])
          && canReadTally(pollId);
        allow create: if docId == 'current'
          && isAdmin()
          && request.resource.data.keys().hasOnly(['counts'])
          && request.resource.data.counts is map;
        allow update: if docId == 'current' && (
          isAdmin()
            && request.resource.data.keys().hasOnly(['counts'])
            && request.resource.data.counts is map
          || tallyBallotOk(pollId)
        );
        allow delete: if false;
      }

      match /voteGuards/{uid} {
        allow read: if false;
        allow create: if uid == request.auth.uid && guardBallotOk(pollId);
        allow update, delete: if false;
      }

      match /participation/{voterId} {
        // 없는 문서도 '명단에 없음'으로 보여 줄 수 있게 get 을 허용한다.
        allow get: if signedIn() && (resource == null || participantShape(resource.data));
        allow list: if isAdmin();
        allow create: if isAdmin()
            && request.resource.data.keys().hasOnly(['voterId', 'voterName', 'status', 'createdAt'])
            && request.resource.data.voterId == voterId
            && request.resource.data.status == 'pending'
            && request.resource.data.voterName is string
            && request.resource.data.createdAt is number
          || partBallotOk(pollId) && request.resource.data.voterId == voterId;
        allow update: if isAdmin()
            && participantShape(request.resource.data)
            && request.resource.data.voterId == voterId
          || partBallotOk(pollId) && request.resource.data.voterId == voterId;
        allow delete: if isAdmin() && resource.data.status != 'completed';
      }
    }

    match /voters/{voterId} {
      // 출석 인증 등 관리자 전용 명단.
      allow read: if isAdmin()
        && resource.data.keys().hasOnly(['name', 'externalQrId', 'memberNo', 'active', 'createdAt']);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'externalQrId', 'active', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.externalQrId is string
        && request.resource.data.externalQrId.size() <= 80
        && request.resource.data.active == true
        && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /voterDirectory/{voterId} {
      allow read: if isAdmin()
        && resource.data.keys().hasOnly(['name', 'active', 'createdAt']);
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'active', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.active is bool
        && request.resource.data.createdAt is number;
      allow delete: if isAdmin();
    }

    function badgeOk(value) {
      return value is int && value >= 100 && value <= 999;
    }

    function checkinShape(d) {
      return d.keys().hasOnly([
          'meetingId', 'voterId', 'voterName', 'claimedAt', 'claimToken', 'authUid', 'badge', 'codeHash', 'revoked'
        ])
        && d.keys().hasAll([
          'meetingId', 'voterId', 'voterName', 'claimedAt', 'claimToken', 'authUid', 'badge', 'codeHash', 'revoked'
        ])
        && validMeetingId(d.meetingId)
        && d.voterId is string
        && d.voterId.size() > 0
        && d.voterId.size() <= 128
        && d.voterName is string
        && d.voterName.size() > 0
        && d.voterName.size() <= 40
        && d.claimedAt is number
        && d.claimToken is string
        && d.claimToken.size() >= 32
        && d.claimToken.size() <= 40
        && d.authUid is string
        && d.authUid.size() > 0
        && d.authUid.size() <= 128
        && badgeOk(d.badge)
        && d.codeHash is string
        && d.codeHash.matches('^[0-9a-f]{64}$')
        && d.revoked is bool;
    }

    // 입장 코드는 원문을 읽지 않고 sha256(meetingId:code) 이름의 문서가 있는지로만 확인한다.
    // 명단을 읽거나 이름을 고르지 않고 익명 계정(uid) 1개당 1번만 입장한다.
    function voterClaimOk(checkinId) {
      let d = request.resource.data;
      return isVoter()
        && checkinShape(d)
        && checkinId == d.meetingId + '_' + request.auth.uid
        && d.authUid == request.auth.uid
        && d.voterId == request.auth.uid
        && d.voterName == string(d.badge) + '번'
        && d.revoked == false
        && nearNow(d.claimedAt)
        && d.meetingId == currentMeetingId()
        && get(/databases/$(database)/documents/entryCodes/$(d.codeHash)).data.meetingId == d.meetingId
        && !exists(lampPath(d.meetingId, d.badge))
        && existsAfter(lampPath(d.meetingId, d.badge));
    }

    // 관리자와 본인만 읽는다. 본인은 같은 기기에서 다시 열 때 자기 입장을 찾는다.
    match /checkins/{checkinId} {
      allow get: if isAdmin()
        || signedIn() && (resource == null || resource.data.get('authUid', '') == request.auth.uid);
      allow list: if isAdmin()
        || signedIn() && resource.data.authUid == request.auth.uid;
      allow create: if voterClaimOk(checkinId);
      // 본인 퇴장: revoked 만 true 로 바꾸고, 같은 쓰기에서 본인 번호(lamp)를 비운다.
      // 퇴장 뒤 같은 기기로 다시 입장: 이미 회수된 문서를 voterClaimOk 로만 덮어쓴다.
      allow update: if voterSelfExitOk(checkinId)
        || resource.data.get('revoked', false) == true
          && resource.data.get('authUid', '') == request.auth.uid
          && voterClaimOk(checkinId)
        || isAdmin()
          && resource.data.get('revoked', true) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
          && request.resource.data.revoked == true;
      allow delete: if isAdmin();
    }

    function voterSelfExitOk(checkinId) {
      return isVoter()
        && resource.data.get('authUid', '') == request.auth.uid
        && checkinId == resource.data.meetingId + '_' + request.auth.uid
        && resource.data.meetingId == currentMeetingId()
        && resource.data.get('revoked', true) == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked == true
        && !existsAfter(lampPath(resource.data.meetingId, resource.data.badge));
    }

    // 예전 이름 선점·재연결 컬렉션은 관리자만 정리용으로 접근한다.
    match /claimedNames/{claimId} {
      allow read, write: if isAdmin();
    }

    match /reissues/{claimId} {
      allow read, write: if isAdmin();
    }

    function lampShape(data, lampId) {
      return data.keys().hasOnly(['meetingId', 'badge', 'state', 'pollId'])
        && validMeetingId(data.meetingId)
        && badgeOk(data.badge)
        && lampId == data.meetingId + '_' + string(data.badge)
        && data.state in ['seated', 'pending', 'voted']
        && data.pollId is string
        && data.pollId.size() <= 80;
    }

    // 현황판은 번호와 투표 여부만 읽는다. 이름도 유권자 id 도 이 문서에 없다.
    // 번호 소유는 본인 checkins 문서(관리자·본인만 읽음)로 확인한다.
    match /lamps/{lampId} {
      allow read: if signedIn();
      allow create: if lampShape(request.resource.data, lampId)
        && (
          isAdmin()
          || isVoter()
            && request.resource.data.state == 'seated'
            && request.resource.data.pollId == ''
            && getAfter(checkinPath(request.resource.data.meetingId, request.auth.uid)).data.badge == request.resource.data.badge
            && getAfter(checkinPath(request.resource.data.meetingId, request.auth.uid)).data.revoked == false
        );
      allow update: if isAdmin()
          && lampShape(request.resource.data, lampId)
          && request.resource.data.badge == resource.data.badge
          && request.resource.data.meetingId == resource.data.meetingId
        || isVoter()
          && resource.data.state == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])
          && request.resource.data.state == 'voted'
          && get(checkinPath(resource.data.meetingId, request.auth.uid)).data.badge == resource.data.badge
          && get(checkinPath(resource.data.meetingId, request.auth.uid)).data.revoked == false
          && getAfter(partPath(resource.data.pollId, get(checkinPath(resource.data.meetingId, request.auth.uid)).data.voterId)).data.status == 'completed';
      allow delete: if isAdmin()
        || isVoter() && voterOwnLampReleaseOk();
    }

    // 본인 퇴장과 같은 쓰기에서만, 본인 번호 칸을 지운다. 이미 회수된 입장으로는 다른 번호를 지울 수 없다.
    function voterOwnLampReleaseOk() {
      let checkin = get(checkinPath(resource.data.meetingId, request.auth.uid)).data;
      let after = getAfter(checkinPath(resource.data.meetingId, request.auth.uid)).data;
      return checkin.authUid == request.auth.uid
        && checkin.badge == resource.data.badge
        && checkin.revoked == false
        && after.authUid == request.auth.uid
        && after.badge == resource.data.badge
        && after.revoked == true;
    }

    // 입장 코드 원문. 관리자만 읽는다.
    match /meeting/{docId} {
      allow read: if isAdmin() && docId == 'current';
      allow create, update: if isAdmin()
        && docId == 'current'
        && request.resource.data.keys().hasOnly(['roomCode', 'meetingId', 'updatedAt'])
        && request.resource.data.roomCode is string
        && request.resource.data.roomCode.matches('^[0-9]{6}$')
        && validMeetingId(request.resource.data.meetingId)
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }

    match /meetingPublic/{docId} {
      allow read: if signedIn() && docId == 'current';
      allow create, update: if isAdmin()
        && docId == 'current'
        && request.resource.data.keys().hasOnly(['meetingId', 'updatedAt'])
        && validMeetingId(request.resource.data.meetingId)
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }

    // 투표와 투표 사이 현황판을 준비 화면으로 바꿀 때 쓴다. 문서는 지우지 않는다.
    match /boardState/{docId} {
      allow read: if signedIn() && docId == 'current';
      allow create, update: if isAdmin()
        && docId == 'current'
        && request.resource.data.keys().hasOnly(['mode', 'updatedAt'])
        && request.resource.data.mode in ['standby', 'results']
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }

    match /entryCodes/{codeHash} {
      allow read: if false;
      allow create: if isAdmin()
        && codeHash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['meetingId', 'createdAt'])
        && validMeetingId(request.resource.data.meetingId)
        && request.resource.data.createdAt is number;
      allow update: if false;
      allow delete: if isAdmin();
    }

    function validSession(data) {
      return data.keys().hasOnly(['eventId', 'voterId', 'voterName', 'checkedInAt', 'expiresAt', 'status'])
        && data.eventId is string
        && data.eventId.size() > 0
        && data.eventId.size() <= 80
        && data.voterId is string
        && data.voterName is string
        && data.checkedInAt is number
        && data.expiresAt == data.checkedInAt + 43200000
        && data.status == 'active';
    }

    match /attendanceSessions/{sessionId} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && sessionId.matches('^session_[0-9a-fA-F-]{36}$')
        && validSession(request.resource.data)
        && exists(/databases/$(database)/documents/voters/$(request.resource.data.voterId));
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /attendanceRawEvents/{eventId} {
      allow read: if false;
      allow create: if isAdmin()
        && eventId.matches('^event_[0-9a-fA-F-]{36}$')
        && request.resource.data.keys().hasOnly(['eventId', 'rawQrValue', 'receivedAt', 'matchedVoterId', 'status'])
        && request.resource.data.eventId is string
        && request.resource.data.rawQrValue is string
        && request.resource.data.receivedAt is number
        && request.resource.data.matchedVoterId is string
        && request.resource.data.status == 'matched';
      allow update, delete: if false;
    }

    match /attendanceOutbox/{outboxId} {
      allow read: if false;
      allow create: if isAdmin()
        && outboxId.matches('^outbox_[0-9a-fA-F-]{36}$')
        && request.resource.data.keys().hasOnly([
          'eventId', 'voterId', 'attendanceSessionId', 'payload', 'status', 'retryCount'
        ])
        && request.resource.data.eventId is string
        && request.resource.data.voterId is string
        && request.resource.data.attendanceSessionId is string
        && request.resource.data.status == 'pending'
        && request.resource.data.retryCount == 0
        && request.resource.data.payload.keys().hasOnly(['voterId', 'voterName', 'checkedInAt'])
        && request.resource.data.payload.voterId == request.resource.data.voterId
        && request.resource.data.payload.voterName is string
        && request.resource.data.payload.checkedInAt is number;
      allow update, delete: if false;
    }
  }
}
